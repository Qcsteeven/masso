# --- PostgreSQL ---
POSTGRES_USER=masso
POSTGRES_PASSWORD=change-me
POSTGRES_DB=masso
DATABASE_URL=postgresql+asyncpg://masso:change-me@db:5432/masso
# пул соединений backend: генерация сценария держит соединение на время прогона валидации
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40

# --- Auth ---
JWT_SECRET=change-me-long-random
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7
SEED_DEFAULT_PASSWORD=masso-demo
# Тестовый режим (make up) — HTTP без TLS, только localhost или изолированная сеть; COOKIE_SECURE=false.
# Эксплуатация (make up-tls) — HTTPS/WSS: сертификат в TLS_CERT_DIR (fullchain.pem, privkey.pem), COOKIE_SECURE=true
# выставляется docker-compose.tls.yml автоматически.
COOKIE_SECURE=false
TLS_CERT_DIR=./certs
HTTPS_PORT=443
# неудачные входы за 15 минут до временной блокировки: по паре email+IP и по IP (за общим NAT класса — увеличить)
LOGIN_MAX_FAILURES=10
LOGIN_MAX_FAILURES_PER_IP=50

# --- LLM (любой OpenAI-совместимый API) ---
# Режим по умолчанию: external | local | template
LLM_GENERATION_MODE=external
# Внешний провайдер
LLM_EXTERNAL_BASE_URL=https://openrouter.ai/api/v1
LLM_EXTERNAL_API_KEY=
LLM_EXTERNAL_CHAT_MODEL=
LLM_EXTERNAL_EMBED_MODEL=
# false — не передавать response_format=json_object (GigaChat через gpt2giga его отклоняет); JSON просит промпт
LLM_EXTERNAL_JSON_MODE=true
# GigaChat через прокси gpt2giga (README, «GigaChat»): раскомментировать COMPOSE_PROFILES, затем
#   LLM_EXTERNAL_BASE_URL=http://gpt2giga:8090/v1, LLM_EXTERNAL_API_KEY=<случайная строка, ключ доступа к прокси>,
#   LLM_EXTERNAL_CHAT_MODEL=GigaChat-2-Max (или GigaChat-2, GigaChat-2-Pro), LLM_EXTERNAL_JSON_MODE=false,
#   LLM_EXTERNAL_EMBED_MODEL — пусто, если эмбеддинги GigaChat не оплачены (тогда хеш-эмбеддинги)
# COMPOSE_PROFILES=gigachat
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# False — только тестовый режим (make up); в make up-tls проверка включается с сертификатом НУЦ Минцифры
GIGACHAT_VERIFY_SSL_CERTS=False
# одновременных запросов к модели (физлица — 1, иначе 429); остальные ждут в очереди прокси до 45 с
GIGACHAT_MAX_CONCURRENCY=1
# Локальный (Ollama: docker compose --profile llm up)
LLM_LOCAL_BASE_URL=http://ollama:11434/v1
LLM_LOCAL_CHAT_MODEL=
# bge-m3 — только вместе с Ollama: без контейнера ollama каждая генерация ждёт ошибку DNS ≈ 8 с
LLM_LOCAL_EMBED_MODEL=
LLM_TIMEOUT_SEC=60

# --- Sandbox ---
SANDBOX_IMAGE=masso/webstack:latest
# label masso.instance: separates installations sharing one Docker daemon (the reaper only removes its own containers)
INSTANCE_ID=masso
SANDBOX_MAX_SESSIONS=20
SANDBOX_IDLE_PAUSE_MIN=15
SANDBOX_EXPIRE_HOURS=24
