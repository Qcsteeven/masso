, /resume, /answers, /run,&lt;br&gt;/ws-token; WS /w​s​/​s​e​s​s​i​o​n​s​/​{​i​d​}​/​t​e​r​m​i​n​a​l, /events&lt;/span&gt;&lt;br&gt;&lt;i&gt;&lt;span style=&quot;font-size:12px&quot;&gt;→ sandbox, coderun, events, audit&lt;/span&gt;&lt;/i&gt;" style="rounded=1;arcSize=6;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontColor=#000000;strokeWidth=1;align=center;verticalAlign=middle;spacing=4;fontSize=12;fontFamily=Times New Roman;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="29.029" y="311.810" width="173.714" height="159.000" as="geometry"/></mxCell><mxCell id="assessment_agent" value="&lt;b&gt;&lt;span style=&quot;font-size:12px&quot;&gt;a​s​s​e​s​s​m​e​n​t​_​a​g​e​n​t&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;[Ком­по­нент: a​p​p​/​a​s​s​e​s​s​m​e​n​t​_​a​g​e​n​t]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;POST /s​e​s​s​i​o​n​s​/​{​i​d​}​/​h​i​n​t​s, /s​e​l​f​-​c​h​e​c​k, /submit;&lt;br&gt;граф L​a​n​g​G​r​a​p​h A​s​s​e​s​s​m​e​n​t​A​g​e​n​t (ри­су­нок 33)&lt;/span&gt;&lt;br&gt;&lt;i&gt;&lt;span style=&quot;font-size:12px&quot;&gt;→ v​e​r​i​f​i​c​a​t​i​o​n, p​r​o​f​i​l​e​_​a​g​e​n​t, l​l​m​_​g​a​t​e​w​a​y, sandbox&lt;/span&gt;&lt;/i&gt;" style="rounded=1;arcSize=6;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontColor=#000000;strokeWidth=1;align=center;verticalAlign=middle;spacing=4;fontSize=12;fontFamily=Times New Roman;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="215.771" y="311.810" width="173.714" height="159.000" as="geometry"/></mxCell><mxCell id="reports" value="&lt;b&gt;&lt;span style=&quot;font-size:12px&quot;&gt;reports&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;[Ком­по­нент: a​p​p​/​r​e​p​o​r​t​s]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;GET /reports, /r​e​p​o​r​t​s​/​e​x​p​o​r​t, /r​e​p​o​r​t​s​/​m​i​n​e,&lt;br&gt;/r​e​p​o​r​t​s​/​b​y​-​s​e​s​s​i​o​n​/​{​i​d​}, /r​e​p​o​r​t​s​/​{​i​d​},&lt;br&gt;/r​e​p​o​r​t​s​/​g​r​o​u​p​s​/​l​i​s​t&lt;/span&gt;" style="rounded=1;arcSize=6;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontColor=#000000;strokeWidth=1;align=center;verticalAlign=middle;spacing=4;fontSize=12;fontFamily=Times New Roman;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="402.514" y="311.810" width="173.714" height="159.000" as="geometry"/></mxCell><mxCell id="events" value="&lt;b&gt;&lt;span style=&quot;font-size:12px&quot;&gt;events&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;[Ком­по­нент: a​p​p​/​e​v​e​n​t​s]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;GET /events, /e​v​e​n​t​s​/​e​x​p​o​r​t;&lt;br&gt;запись циф­ро­во­го следа и шина со­бы­тий&lt;br&gt;сессии в про­цес­се (bus) для W​e​b​S​o​c​k​e​t&lt;/span&gt;" style="rounded=1;arcSize=6;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontColor=#000000;strokeWidth=1;align=center;verticalAlign=middle;spacing=4;fontSize=12;fontFamily=Times New Roman;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="589.257" y="311.810" width="173.714" height="159.000" as="geometry"/></mxCell><mxCell id="admin" value="&lt;b&gt;&lt;span style=&quot;font-size:12px&quot;&gt;admin&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;[Ком­по­нент: a​p​p​/​a​d​m​i​n]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;GET, PATCH /a​d​m​i​n​/​s​a​n​d​b​o​x​/​p​r​o​f​i​l​e​s; GET /a​d​m​i​n​/​a​u​d​i​t,&lt;br&gt;/a​d​m​i​n​/​s​e​c​u​r​i​t​y​-​e​v​e​n​t​s, /a​d​m​i​n​/​l​o​g​s​/​e​x​p​o​r​t, /a​d​m​i​n​/​h​e​a​l​t​h,&lt;br&gt;/a​d​m​i​n​/​b​a​c​k​g​r​o​u​n​d, /a​d​m​i​n​/​o​p​e​n​a​p​i​.​j​s​o​n;&lt;br&gt;POST /a​d​m​i​n​/​s​a​n​d​b​o​x​e​s​/​{​i​d​}​/​c​l​e​a​n​u​p&lt;/span&gt;&lt;br&gt;&lt;i&gt;&lt;span style=&quot;font-size:12px&quot;&gt;→ sandbox, audit&lt;/span&gt;&lt;/i&gt;" style="rounded=1;arcSize=6;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontColor=#000000;strokeWidth=1;align=center;verticalAlign=middle;spacing=4;fontSize=12;fontFamily=Times New Roman;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="29.029" y="474.719" width="173.714" height="174.000" as="geometry"/></mxCell><mxCell id="verification" value="&lt;b&gt;&lt;span style=&quot;font-size:12px&quot;&gt;v​e​r​i​f​i​c​a​t​i​o​n&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;[Ком­по­нент: a​p​p​/​v​e​r​i​f​i​c​a​t​i​o​n]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;GET, PATCH /v​e​r​i​f​i​c​a​t​i​o​n​/​{​s​e​s​s​i​o​n​_​i​d​};&lt;br&gt;V​e​r​i​f​i​c​a​t​i​o​n Engine: d​o​c​k​e​r​_​i​n​s​p​e​c​t, d​o​c​k​e​r​_​e​x​e​c,&lt;br&gt;h​t​t​p​_​h​e​a​l​t​h, f​i​l​e​_​d​i​f​f, r​u​l​e​_​m​a​t​c​h, s​e​m​a​n​t​i​c​_​s​i​m​i​l​a​r​i​t​y,&lt;br&gt;n​u​m​e​r​i​c​_​m​a​t​c​h, c​o​d​e​_​c​a​s​e​s, c​o​d​e​_​s​t​u​d​e​n​t​_​t​e​s​t​s&lt;/span&gt;&lt;br&gt;&lt;i&gt;&lt;span style=&quot;font-size:12px&quot;&gt;→ sandbox, coderun&lt;/span&gt;&lt;/i&gt;" style="rounded=1;arcSize=6;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontColor=#000000;strokeWidth=1;align=center;verticalAlign=middle;spacing=4;fontSize=12;fontFamily=Times New Roman;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="215.771" y="474.719" width="173.714" height="174.000" as="geometry"/></mxCell><mxCell id="scenario_agent" value="&lt;b&gt;&lt;span style=&quot;font-size:12px&quot;&gt;s​c​e​n​a​r​i​o​_​a​g​e​n​t&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;[Ком­по­нент: a​p​p​/​s​c​e​n​a​r​i​o​_​a​g​e​n​t]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;S​c​e​n​a​r​i​o​A​g​e​n​t — граф L​a​n​g​G​r​a​p​h ге­не­ра­ции&lt;br&gt;и ва­ли­да­ции ва­ри­ан­та (ри­су­нок 33)&lt;/span&gt;&lt;br&gt;&lt;i&gt;&lt;span style=&quot;font-size:12px&quot;&gt;→ l​l​m​_​g​a​t​e​w​a​y, sandbox, coderun&lt;/span&gt;&lt;/i&gt;" style="rounded=1;arcSize=6;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontColor=#000000;strokeWidth=1;align=center;verticalAlign=middle;spacing=4;fontSize=12;fontFamily=Times New Roman;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="402.514" y="474.719" width="173.714" height="174.000" as="geometry"/></mxCell><mxCell id="profile_agent" value="&lt;b&gt;&lt;span style=&quot;font-size:12px&quot;&gt;p​r​o​f​i​l​e​_​a​g​e​n​t&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;[Ком­по­нент: a​p​p​/​p​r​o​f​i​l​e​_​a​g​e​n​t]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;P​r​o​f​i​l​e​A​g​e​n​t — сервис: де­фи­ци­ты на­вы­ков,&lt;br&gt;ре­ко­мен­да­ции, об­нов­ле­ние уров­ней&lt;/span&gt;" style="rounded=1;arcSize=6;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontColor=#000000;strokeWidth=1;align=center;verticalAlign=middle;spacing=4;fontSize=12;fontFamily=Times New Roman;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="589.257" y="474.719" width="173.714" height="174.000" as="geometry"/></mxCell><mxCell id="coderun" value="&lt;b&gt;&lt;span style=&quot;font-size:12px&quot;&gt;coderun&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;[Ком­по­нент: a​p​p​/​c​o​d​e​r​u​n]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Запуск кода: од­но­ра­зо­вый кон­тей­нер пе­соч­ни­цы,&lt;br&gt;скры­тые тесты по груп­пам, тесты обу­ча­ю­ще­го­ся&lt;br&gt;на эта­ло­не и на му­тан­тах&lt;/span&gt;&lt;br&gt;&lt;i&gt;&lt;span style=&quot;font-size:12px&quot;&gt;→ sandbox&lt;/span&gt;&lt;/i&gt;" style="rounded=1;arcSize=6;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontColor=#000000;strokeWidth=1;align=center;verticalAlign=middle;spacing=4;fontSize=12;fontFamily=Times New Roman;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="29.029" y="652.627" width="173.714" height="129.000" as="geometry"/></mxCell><mxCell id="worker" value="&lt;b&gt;&lt;span style=&quot;font-size:12px&quot;&gt;worker&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;[Ком­по­нент: a​p​p​/​w​o​r​k​e​r​.​p​y]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Фо­но­вый worker — задача asyncio того же про­цес­са:&lt;br&gt;i​n​c​i​d​e​n​t​s, commands, idle, reaper, r​e​t​e​n​t​i​o​n,&lt;br&gt;t​i​m​e​_​l​i​m​i​t, quota&lt;/span&gt;&lt;br&gt;&lt;i&gt;&lt;span style=&quot;font-size:12px&quot;&gt;→ sessions, a​s​s​e​s​s​m​e​n​t​_​a​g​e​n​t&lt;/span&gt;&lt;/i&gt;" style="rounded=1;arcSize=6;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontColor=#000000;strokeWidth=1;align=center;verticalAlign=middle;spacing=4;fontSize=12;fontFamily=Times New Roman;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="215.771" y="652.627" width="173.714" height="129.000" as="geometry"/></mxCell><mxCell id="audit" value="&lt;b&gt;&lt;span style=&quot;font-size:12px&quot;&gt;audit&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;[Ком­по­нент: a​p​p​/​a​u​d​i​t]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Запись a​u​d​i​t​_​l​o​g​s и s​e​c​u​r​i​t​y​_​e​v​e​n​t​s;&lt;br&gt;a​g​e​n​t​_​l​o​g​s пишет l​l​m​_​g​a​t​e​w​a​y&lt;/span&gt;" style="rounded=1;arcSize=6;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontColor=#000000;strokeWidth=1;align=center;verticalAlign=middle;spacing=4;fontSize=12;fontFamily=Times New Roman;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="402.514" y="652.627" width="173.714" height="129.000" as="geometry"/></mxCell><mxCell id="health" value="&lt;b&gt;&lt;span style=&quot;font-size:12px&quot;&gt;health&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;[Ком­по­нент: main.py, a​p​p​/​h​e​a​l​t​h​.​p​y]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Слу­жеб­ные эн­д­по­ин­ты:&lt;br&gt;GET /a​p​i​/​h​e​a​l​t​h, /metrics&lt;/span&gt;" style="rounded=1;arcSize=6;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontColor=#000000;strokeWidth=1;align=center;verticalAlign=middle;spacing=4;fontSize=12;fontFamily=Times New Roman;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="589.257" y="652.627" width="173.714" height="129.000" as="geometry"/></mxCell><mxCell id="db" value="&lt;b&gt;&lt;span style=&quot;font-size:12px&quot;&gt;db&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;[Ком­по­нент: a​p​p​/​d​b​.​p​y]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Доступ к данным: S​Q​L​A​l​c​h​e​m​y 2 async, asyncpg;&lt;br&gt;модели таблиц в па­ке­тах мо­ду­лей&lt;/span&gt;" style="rounded=1;arcSize=6;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontColor=#000000;strokeWidth=1;align=center;verticalAlign=middle;spacing=4;fontSize=12;fontFamily=Times New Roman;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="29.029" y="785.536" width="173.714" height="159.000" as="geometry"/></mxCell><mxCell id="llm_gateway" value="&lt;b&gt;&lt;span style=&quot;font-size:12px&quot;&gt;l​l​m​_​g​a​t​e​w​a​y&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;[Ком­по­нент: a​p​p​/​l​l​m​_​g​a​t​e​w​a​y]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;GET /a​d​m​i​n​/​l​l​m​/​p​r​o​v​i​d​e​r​s, /a​d​m​i​n​/​l​l​m​/​h​e​a​l​t​h, /l​l​m​/​s​t​a​t​u​s;&lt;br&gt;PATCH /a​d​m​i​n​/​l​l​m​/​p​r​o​v​i​d​e​r​s​/​{​i​d​}; POST /a​d​m​i​n​/​l​l​m​/​s​w​i​t​c​h​-​m​o​d​e;&lt;br&gt;fallback external → local → template&lt;/span&gt;&lt;br&gt;&lt;i&gt;&lt;span style=&quot;font-size:12px&quot;&gt;→ audit&lt;/span&gt;&lt;/i&gt;" style="rounded=1;arcSize=6;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontColor=#000000;strokeWidth=1;align=center;verticalAlign=middle;spacing=4;fontSize=12;fontFamily=Times New Roman;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="215.771" y="785.536" width="173.714" height="159.000" as="geometry"/></mxCell><mxCell id="sandbox" value="&lt;b&gt;&lt;span style=&quot;font-size:12px&quot;&gt;sandbox&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;[Ком­по­нент: a​p​p​/​s​a​n​d​b​o​x]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Sandbox Mana