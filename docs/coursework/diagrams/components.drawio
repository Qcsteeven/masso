=Times New Roman;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="16.000" y="25.359" width="51.546" height="294.000" as="geometry"/></mxCell><mxCell id="fe" value="&lt;b&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Frontend&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;[Кон­тей­нер: nginx 1.27; React 19, T​y​p​e​S​c​r​i​p​t, Vite]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;SPA ролей, веб-тер­ми­нал xterm.js, ре­дак­тор&lt;br&gt;кода C​o​d​e​M​i​r​r​o​r 6; прокси /api, /ws, /metrics&lt;/span&gt;" style="rounded=1;arcSize=6;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontColor=#000000;strokeWidth=1;align=center;verticalAlign=middle;spacing=4;fontSize=12;fontFamily=Times New Roman;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="103.629" y="23.759" width="87.629" height="296.400" as="geometry"/></mxCell><mxCell id="be" value="&lt;b&gt;&lt;span style=&quot;font-size:12px&quot;&gt;B​a​c​k​e​n​d​/​A​P​I&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;[Кон­тей­нер: Python 3.13, FastAPI, uvicorn]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;REST /api и W​e​b​S​o​c​k​e​t /ws; агенты L​a​n​g​G​r​a​p​h,&lt;br&gt;LLM Gateway, Sandbox Manager, V​e​r​i​f​i​c​a​t​i​o​n&lt;br&gt;Engine, запуск кода; фо­но­вый worker —&lt;br&gt;задача asyncio того же про­цес­са&lt;/span&gt;" style="rounded=1;arcSize=6;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontColor=#000000;strokeWidth=1;align=center;verticalAlign=middle;spacing=4;fontSize=12;fontFamily=Times New Roman;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="232.495" y="22.959" width="103.093" height="297.200" as="geometry"/></mxCell><mxCell id="g2g" value="&lt;b&gt;&lt;span style=&quot;font-size:12px&quot;&gt;gpt2giga&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;[Кон­тей­нер, про­филь gigachat]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;OpenAI-сов­ме­сти­мый&lt;br&gt;адап­тер GigaChat;&lt;br&gt;порт не пуб­ли­ку­ет­ся&lt;/span&gt;" style="rounded=1;arcSize=6;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontColor=#000000;strokeWidth=1;align=center;verticalAlign=middle;spacing=4;fontSize=12;fontFamily=Times New Roman;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="356.206" y="23.759" width="51.546" height="295.600" as="geometry"/></mxCell><mxCell id="env" value="&lt;b&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Учеб­ные среды&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;[Кон­тей­не­ры: образ m​a​s​s​o​/​w​e​b​s​t​a​c​k]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;учеб­ный сервер сессии (nginx, s​t​o​r​e​-​a​p​i,&lt;br&gt;P​o​s​t​g​r​e​S​Q​L); од­но­ра­зо­вые кон­тей­не­ры&lt;br&gt;за­пус­ка кода и ва­ли­да­ции; сеть от­клю­че­на&lt;/span&gt;" style="rounded=1;arcSize=6;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontColor=#000000;strokeWidth=1;align=center;verticalAlign=middle;spacing=4;fontSize=12;fontFamily=Times New Roman;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="103.629" y="485.378" width="87.629" height="249.000" as="geometry"/></mxCell><mxCell id="db" value="&lt;b&gt;&lt;span style=&quot;font-size:12px&quot;&gt;P​o​s​t​g​r​e​S​Q​L&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;[Кон­тей­нер: P​o​s​t​g​r​e​S​Q​L 18 + pgvector]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Поль­зо­ва­те­ли, граф ком­пе­тен­ций&lt;br&gt;с те­о­ри­ей, сце­на­рии, сессии,&lt;br&gt;циф­ро­вой след, отчёты, жур­на­лы&lt;/span&gt;" style="shape=cylinder3;html=1;boundedLbl=1;backgroundOutline=1;size=14;strokeColor=#000000;fillColor=#FFFFFF;fontColor=#000000;fontSize=12;fontFamily=Times New Roman;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="232.495" y="484.578" width="82.474" height="250.600" as="geometry"/></mxCell><mxCell id="oll" value="&lt;b&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Ollama&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;[Кон­тей­нер, про­филь llm,&lt;br&gt;оп­ци­о­наль­но]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;ло­каль­ная модель&lt;br&gt;и эм­бед­дин­ги&lt;/span&gt;" style="rounded=1;arcSize=6;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontColor=#000000;strokeWidth=1;align=center;verticalAlign=middle;spacing=4;dashed=1;dashPattern=4 3;fontSize=12;fontFamily=Times New Roman;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="356.206" y="485.378" width="51.546" height="249.000" as="geometry"/></mxCell><mxCell id="giga" value="&lt;b&gt;&lt;span style=&quot;font-size:12px&quot;&gt;GigaChat API&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;[Внеш­няя си­сте­ма]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;об­лач­ная модель Сбера&lt;/span&gt;" style="rounded=1;arcSize=6;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontColor=#000000;strokeWidth=1;align=center;verticalAlign=middle;spacing=4;dashed=1;dashPattern=4 3;fontSize=12;fontFamily=Times New Roman;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="438.680" y="23.759" width="77.320" height="295.600" as="geometry"/></mxCell><mxCell id="oai" value="&lt;b&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Внеш­ний LLM-про­вай­дер&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;[Внеш­няя си­сте­ма, оп­ци­о­наль­но]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;иной OpenAI-сов­ме­сти­мый API&lt;/span&gt;" style="rounded=1;arcSize=6;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontColor=#000000;strokeWidth=1;align=center;verticalAlign=middle;spacing=4;dashed=1;dashPattern=4 3;fontSize=12;fontFamily=Times New Roman;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="438.680" y="323.252" width="77.320" height="159.780" as="geometry"/></mxCell><mxCell id="mon" value="&lt;b&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Си­сте­ма