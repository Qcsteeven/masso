om=3;fontSize=12;fontFamily=Times New Roman;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="24.000" y="128.000" width="84.000" height="27.000" as="geometry"/></mxCell><mxCell id="c10" value="Вы­пол­нять&lt;br&gt;за­да­ние:&lt;br&gt;тер­ми­нал,&lt;br&gt;до­ку­мен­ты или&lt;br&gt;ре­дак­тор кода" style="rounded=1;arcSize=12;html=1;strokeColor=#000000;fontColor=#000000;fillColor=#FFFFFF;spacing=4;fontSize=12;fontFamily=Times New Roman;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="24.000" y="200.000" width="84.000" height="147.000" as="geometry"/></mxCell><mxCell id="c11" value="" style="rhombus;html=1;strokeColor=#000000;fontColor=#000000;fillColor=#FFFFFF;verticalAlign=middle;spacingBottom=3;fontSize=12;fontFamily=Times New Roman;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="57.000" y="407.000" width="18.000" height="18.000" as="geometry"/></mxCell><mxCell id="c12" value="Нужна под­сказ­ка?" style="text;html=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;fontColor=#000000;fontStyle=0;strokeColor=none;fillColor=#FFFFFF;fontSize=12;fontFamily=Times New Roman;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="24.000" y="359.000" width="84.000" height="42.000" as="geometry"/></mxCell><mxCell id="c13" value="Под­сказ­ка: ≤ 3,&lt;br&gt;−10 %; LLM или&lt;br&gt;сту­пень лест­ни­цы;&lt;br&gt;i​n​j​e​c​t​i​o​n —&lt;br&gt;на­ру­ше­ние" style="rounded=1;arcSize=12;html=1;strokeColor=#000000;fontColor=#000000;fillColor=#FFFFFF;spacing=4;fontSize=12;fontFamily=Times New Roman;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="124.000" y="350.000" width="84.000" height="240.000" as="geometry"/></mxCell><mxCell id="c14" value="" style="rhombus;html=1;strokeColor=#000000;fontColor=#000000;fillColor=#FFFFFF;verticalAlign=middle;spacingBottom=3;fontSize=12;fontFamily=Times New Roman;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="57.000" y="650.000" width="18.000" height="18.000" as="geometry"/></mxCell><mxCell id="c15" value="Про­ве­рить&lt;br&gt;вы­пол­не­ние?" style="text;html=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;fontColor=#000000;fontStyle=0;strokeColor=none;fillColor=#FFFFFF;fontSize=12;fontFamily=Times New Roman;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="24.000" y="602.000" width="84.000" height="42.000" as="geometry"/></mxCell><mxCell id="c16" value="Са­мо­про­вер­ка:&lt;br&gt;на­зва­ния&lt;br&gt;кри­те­ри­ев и&lt;br&gt;ре­зуль­тат; ≤ 1 раз&lt;br&gt;в 30 с" style="rounded=1;arcSize=12;html=1;strokeColor=#000000;fontColor=#000000;fillColor=#FFFFFF;spacing=4;fontSize=12;fontFamily=Times New Roman;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="224.000" y="593.000" width="84.000" height="204.000" as="geometry"/></mxCell><mxCell id="c17" value="За­вер­шить и&lt;br&gt;от­пра­вить" style="rounded=1;arcSize=12;html=1;strokeColor=#000000;fontColor=#000000;fillColor=#FFFFFF;spacing=4;fontSize=12;fontFamily=Times New Roman;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="24.000" y="800.000" width="84.000" height="42.000" as="geometry"/></mxCell><mxCell id="c18" value="Каждые 5 с:&lt;br&gt;ко­ман­ды из&lt;br&gt;жур­на­ла,&lt;br&gt;на­ру­ше­ния" style="rounded=1;arcSize=12;html=1;strokeColor=#000000;fontColor=#000000;fillColor=#FFFFFF;spacing=4;fontSize=12;fontFamily=Times New Roman;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="324.000" y="125.000" width="84.000" height="72.000" as="geometry"/></mxCell><mxCell id="c19" value="На­сту­пил срок —&lt;br&gt;ин­ци­дент&lt;br&gt;ва­ри­ан­та,&lt;br&gt;WS-уве­дом­ле­ние;&lt;br&gt;сле­ду­ю­щий через&lt;br&gt;2–5 мин" style="rounded=1;arcSize=12;html=1;strokeColor=#000000;fontColor=#000000;fillColor=#FFFFFF;spacing=4;fontSize=12;fontFamily=Times New Roman;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="324.000" y="200.000" width="84.000" height="147.000" as="geometry"/></mxCell><mxCell id="c20" value="" style="rhombus;html=1;strokeColor=#000000;fontColor=#000000;fillColor=#FFFFFF;verticalAlign=middle;spacingBottom=3;fontSize=12;fontFamily=Times New Roman;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="357.000" y="437.000" width="18.000" height="18.000" as="geometry"/></mxCell><mxCell id="c21" value="Время вышло или&lt;br&gt;диск пре­вы­шен?" style="text;html=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;fontColor=#000000;fontStyle=0;strokeColor=none;fillColor=#FFFFFF;fontSize=12;fontFamily=Times New Roman;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="324.000" y="359.000" width="84.000" height="72.000" as="geometry"/></mxCell><mxCell id="c22" value="Без­дей­ствие: 15&lt;br&gt;мин — пауза, 24 ч&lt;br&gt;— expired" style="rounded=1;arcSize=12;html=1;strokeColor=#000000;fontColor=#000000;fillColor=#FFFFFF;spacing=4;fontSize=12;fontFamily=Times New Roman;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="324.000" y="593.000" width="84.000" height="204.000" as="geometry"/></mxCell><mxCell id="c23" value="Со­брать след:&lt;br&gt;со­бы­тия,&lt;br&gt;под­сказ­ки,&lt;br&gt;на­ру­ше­ния" style="rounded=1;arcSize=12;html=1;strokeColor=#000000;fontColor=#000000;fillColor=#FFFFFF;spacing=4;fontSize=12;fontFamily=Times New Roman;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="124.000" y="845.000" width="84.000" height="72.000" as="geometry"/></mxCell><mxCell id="c24" value="Про­вер­ки: сервер&lt;br&gt;— в кон­тей­не­ре,&lt;br&gt;до­ку­мент — по&lt;br&gt;ключу, код — в&lt;br&gt;пе­соч­ни­це" style="rounded=1;arcSize=12;html=1;strokeColor=#000000;fontColor=#000000;fillColor=#FFFFFF;spacing=4;fontSize=12;fontFamily=Times New Roman;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="224.000" y="920.000" width="84.000" height="147.000" as="geometry"/></mxCell><mxCell id="c25" value="Балл: веса,&lt;br&gt;кри­ти­че­ская ≤ 49,&lt;br&gt;−10 % за&lt;br&gt;под­сказ­ку, −10 за&lt;br&gt;на­ру­ше­ние" style="rounded=1;arcSize=12;html=1;strokeColor=#000000;fontColor=#000000;fillColor=#FFFFFF;spacing=4