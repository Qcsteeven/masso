<mxfile host="app.diagrams.net" agent="MASSO generator" version="24.0.0"><diagram id="fig26_c4_context" name="fig26_c4_context"><mxGraphModel dx="1860" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1860" pageHeight="1100" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="sys" value="&lt;b&gt;&lt;span style=&quot;font-size:16px&quot;&gt;МАССО&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Программная система]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Генерация, проведение, автоматическая&lt;br&gt;проверка и анализ ситуативных учебных&lt;br&gt;сценариев: учебный сервер, документный&lt;br&gt;тренажёр, задача на код&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#F2F2F2;fontFamily=Times New Roman;fontColor=#000000;fontSize=12;strokeWidth=2;align=center;verticalAlign=middle;spacing=4;arcSize=3;" vertex="1" parent="1"><mxGeometry x="760" y="60" width="400" height="1000" as="geometry"/></mxCell><mxCell id="x_1" value="" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;strokeColor=#000000;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="194.0" y="60" width="32" height="46" as="geometry"/></mxCell><mxCell id="p0" value="&lt;b&gt;&lt;span style=&quot;font-size:13px&quot;&gt;Обучающийся&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Пользователь]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Проходит сценарии трёх видов, запрашивает&lt;br&gt;подсказки и самопроверку, читает теорию&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontFamily=Times New Roman;fontColor=#000000;fontSize=12;strokeWidth=1;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="340" height="