_dump]&lt;/font&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;Ежедневно, хранение 30 дней&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontFamily=Times New Roman;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="860.0" y="420.0" width="170.0" height="90.0" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Docker Engine&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;[Сервис ОС]&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontFamily=Times New Roman;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="320.0" y="420.0" width="210.0" height="56.0" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Внешний LLM-провайдер&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;[Внешняя система]&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;dashed=1;strokeColor=#000000;fillColor=#FFFFFF;fontFamily=Times New Roman;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1110.0" y="70.0" width="200.0" height="70.0" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Prometheus&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;[Опционально]&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;dashed=1;strokeColor=#000000;fillColor=#FFFFFF;fontFamily=Times New Roman;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1110.0" y="240.0" width="200.0" height="60.0" as="geometry"/></mxCell><mxCell id="c14" value="HTTPS, WSS" style="html=1;rounded=0;endArrow=block;endFill=1;endSize=7;strokeColor=#000000;fontFamily=Times New Roman;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;dashed=1;fontSize=10;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c1" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></m