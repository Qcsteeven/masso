<mxfile host="app.diagrams.net" agent="MASSO generator" version="24.0.0"><diagram id="fig29_c4_component_backend" name="fig29_c4_component_backend"><mxGraphModel dx="1810" dy="1240" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1810" pageHeight="1240" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="x_1" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontFamily=Times New Roman;fontColor=#000000;fontSize=12;strokeWidth=1;align=center;verticalAlign=middle;spacing=4;dashed=1;dashPattern=4 3;arcSize=1;" vertex="1" parent="1"><mxGeometry x="30" y="170" width="1750" height="890" as="geometry"/></mxCell><mxCell id="x_2" value="Backend/API [Контейнер: Python 3.13, FastAPI]" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Times New Roman;fontColor=#000000;fontSize=12;align=left;verticalAlign=middle;fontStyle=0;spacing=2;" vertex="1" parent="1"><mxGeometry x="1350" y="1030" width="420" height="24" as="geometry"/></mxCell><mxCell id="fe" value="&lt;b&gt;&lt;span style=&quot;font-size:13px&quot;&gt;Frontend&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Контейнер: nginx + React SPA]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;запросы REST и WebSocket проксирует nginx&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontFamily=Times New Roman;fontColor=#000000;fontSize=12;strokeWidth=1;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="700" y="20" width="440" height="100" as="geometry"/></mxCell><mxCell id="bnd" value="" style="rounded=0;html=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="30" y="170" width="1750" height="890" as="geometry"/></mxCell><mxCell id="x_3" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#000000;fontFamily=Times New Roman;fontColor=#000000;fontSize=10;endSize=9;startSize=9;startArrow=none;endArrow=block;startFill=1;endFill=1;strokeWidth=1;exitX=0.2727;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.4514;entryY=0.0000;entryDx=0;entryDy=0;dashed=1;dashPattern=4 3;" edge="1" parent="1" source="fe" target="bnd"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="x_4" value="REST /api [HTTPS]" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Times New Roman;fontColor=#000000;fontSize=10;align=right;verticalAlign=middle;fontStyle=0;spacing=2;" vertex="1" parent="1"><mxGeometry x="640" y="132" width="176" height="24" as="geometry"/></mxCell><mxCell id="x_5" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#000000;fontFamily=Times New Roman;fontColor=#000000;fontSize=10;endSize=9;startSize=9;startArrow=none;endArrow=block;startFill=1;endFill=1;strokeWidth=1;exitX=0.7273;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5657;entryY=0.0000;entryDx=0;entryDy=0;dashed=1;dashPattern=4 3;" edge="1" parent="1" source="fe" target="bnd"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="x_6" value="WebSocket /ws [WSS]" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Times New Roman;fontColor=#000000;fontSize=10;align=left;verticalAlign=middle;fontStyle=0;spacing=2;" vertex="1" parent="1"><mxGeometry x="1026" y="132" width="220" height="24" as="geometry"/></mxCell><mxCell id="auth" value="&lt;b&gt;&lt;span style=&quot;font-size:12px&quot;&gt;auth&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Компонент: app/auth]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;POST /auth/login, /auth/refresh, /auth/logout;&lt;br&gt;GET /auth/me; JWT и refresh-cookie, argon2,&lt;br&gt;проверка ролей (deps.py), блокировка подбора пароля&lt;/span&gt;&lt;br&gt;&lt;i&gt;&lt;span style=&quot;font-size:10px&quot;&gt;→ audit&lt;/span&gt;&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontFamily=Times New Roman;fontColor=#000000;fontSize=11;strokeWidth=1;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="60" y="200" width="400" height="150" as="geometry"/></mxCell><mxCell id="users" value="&lt;b&gt;&lt;span style=&quot;font-size:12px&quot;&gt;users&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Компонент: app/users]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;GET, POST /users; PATCH /users/{id};&lt;br&gt;PUT /users/{id}/roles;&lt;br&gt;POST /users/{id}/revoke-sessions; GET /users/{id}/audit&lt;/span&gt;&lt;br&gt;&lt;i&gt;&lt;span style=&quot;font-size:10px&quot;&gt;→ audit&lt;/span&gt;&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontFamily=Times New Roman;fontColor=#000000;fontSize=11;strokeWidth=1;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="490" y="200" width="400" height="150" as="geometry"/></mxCell><mxCell id="skills" value="&lt;b&gt;&lt;span style=&quot;font-size:12px&quot;&gt;skills&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Компонент: app/skills]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;GET /skills/graph, /skills/me, /skills/recommendations;&lt;br&gt;GET, POST /skills/domains; PATCH /skills/domains/{code};&lt;br&gt;POST /skills, /skills/import; PATCH /skills/{id};&lt;br&gt;PUT /skills/targets&lt;/span&gt;&lt;br&gt;&lt;i&gt;&lt;span style=&quot;font-size:10px&quot;&gt;→ profile_agent, audit&lt;/span&gt;&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontFamily=Times New Roman;fontColor=#000000;fontSize=11;strokeWidth=1;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="920" y="200" width="400" height="150" as="geometry"/></mxCell><mxCell id="scenarios" value="&lt;b&gt;&lt;span style=&quot;font-size:12px&quot;&gt;scenarios&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Компонент: app/scenarios]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;GET, POST /scenarios/templates; GET, PATCH …/{id};&lt;br&gt;POST …/{id}/validate, /publish, /archive; GET /spec-schema;&lt;br&gt;POST /scenarios/generate; GET /scenarios/runs/{id};&lt;br&gt;POST, GET /scenarios/assignments; GET …/assignments/me&lt;/span&gt;&lt;br&gt;&lt;i&gt;&lt;span style=&quot;font-size:10px&quot;&gt;→ scenario_agent, audit&lt;/span&gt;&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontFamily=Times New Roman;fontColor=#000000;fontSize=11;strokeWidth=1;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1350" y="200" width="400" height="150" as="geometry"/></mxCell><mxCell id="sessions" value="&lt;b&gt;&lt;span style=&quot;font-size:12px&quot;&gt;sessions&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Компонент: app/sessions]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;POST /sessions; GET /sessions/mine, /sessions/{id};&lt;br&gt;POST /sessions/{id}/pause, /resume, /answers, /run,&lt;br&gt;/ws-token; WS /ws/sessions/{id}/terminal, /events&lt;/span&gt;&lt;br&gt;&lt;i&gt;&lt;span style=&quot;font-size:10px&quot;&gt;→ sandbox, coderun, events, audit&lt;/span&gt;&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontFamily=Times New Roman;fontColor=#000000;fontSize=11;strokeWidth=1;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="60" y="380" width="400" height="150" as="geometry"/></mxCell><mxCell id="assessment_agent" value="&lt;b&gt;&lt;span style=&quot;font-size:12px&quot;&gt;assessment_agent&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Компонент: app/assessment_agent]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;POST /sessions/{id}/hints, /self-check, /submit;&lt;br&gt;граф LangGraph AssessmentAgent (рисунок 30)&lt;/span&gt;&lt;br&gt;&lt;i&gt;&lt;span style=&quot;font-size:10px&quot;&gt;→ verification, profile_agent, llm_gateway, sandbox&lt;/span&gt;&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontFamily=Times New Roman;fontColor=#000000;fontSize=11;strokeWidth=1;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="490" y="380" width="400" height="150" as="geometry"/></mxCell><mxCell id="reports" value="&lt;b&gt;&lt;span style=&quot;font-size:12px&quot;&gt;reports&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Компонент: app/reports]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;GET /reports, /reports/export, /reports/mine,&lt;br&gt;/reports/by-session/{id}, /reports/{id},&lt;br&gt;/reports/groups/list&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontFamily=Times New Roman;fontColor=#000000;fontSize=11;strokeWidth=1;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="920" y="380" width="400" height="150" as="geometry"/></mxCell><mxCell id="events" value="&lt;b&gt;&lt;span style=&quot;font-size:12px&quot;&gt;events&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Компонент: app/events]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;GET /events, /events/export;&lt;br&gt;запись цифрового следа и шина событий&lt;br&gt;сессии в процессе (bus) для WebSocket&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontFamily=Times New Roman;fontColor=#000000;fontSize=11;strokeWidth=1;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1350" y="380" width="400" height="150" as="geometry"/></mxCell><mxCell id="admin" value="&lt;b&gt;&lt;span style=&quot;font-size:12px&quot;&gt;admin&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Компонент: app/admin]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;GET, PATCH /admin/sandbox/profiles; GET /admin/audit,&lt;br&gt;/admin/security-events, /admin/logs/export, /admin/health,&lt;br&gt;/admin/background, /admin/openapi.json;&lt;br&gt;POST /admin/sandboxes/{id}/cleanup&lt;/span&gt;&lt;br&gt;&lt;i&gt;&lt;span style=&quot;font-size:10px&quot;&gt;→ sandbox, audit&lt;/span&gt;&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontFamily=Times New Roman;fontColor=#000000;fontSize=11;strokeWidth=1;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="60" y="560" width="400" height="150" as="geometry"/></mxCell><mxCell id="verification" value="&lt;b&gt;&lt;span style=&quot;font-size:12px&quot;&gt;verification&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Компонент: app/verification]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;GET, PATCH /verification/{session_id};&lt;br&gt;Verification Engine: docker_inspect, docker_exec,&lt;br&gt;http_health, file_diff, rule_match, semantic_similarity,&lt;br&gt;numeric_match, code_cases, code_student_tests&lt;/span&gt;&lt;br&gt;&lt;i&gt;&lt;span style=&quot;font-size:10px&quot;&gt;→ sandbox, coderun&lt;/span&gt;&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontFamily=Times New Roman;fontColor=#000000;fontSize=11;strokeWidth=1;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="490" y="560" width="400" height="150" as="geometry"/></mxCell><mxCell id="scenario_agent" value="&lt;b&gt;&lt;span style=&quot;font-size:12px&quot;&gt;scenario_agent&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Компонент: app/scenario_agent]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;ScenarioAgent — граф LangGraph генерации&lt;br&gt;и валидации варианта (рисунок 30)&lt;/span&gt;&lt;br&gt;&lt;i&gt;&lt;span style=&quot;font-size:10px&quot;&gt;→ llm_gateway, sandbox, coderun&lt;/span&gt;&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontFamily=Times New Roman;fontColor=#000000;fontSize=11;strokeWidth=1;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="920" y="560" width="400" height="150" as="geometry"/></mxCell><mxCell id="profile_agent" value="&lt;b&gt;&lt;span style=&quot;font-size:12px&quot;&gt;profile_agent&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Компонент: app/profile_agent]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;ProfileAgent — сервис: дефициты навыков,&lt;br&gt;рекомендации, обновление уровней&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontFamily=Times New Roman;fontColor=#000000;fontSize=11;strokeWidth=1;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1350" y="560" width="400" height="150" as="geometry"/></mxCell><mxCell id="coderun" value="&lt;b&gt;&lt;span style=&quot;font-size:12px&quot;&gt;coderun&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Компонент: app/coderun]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;Запуск кода: одноразовый контейнер песочницы,&lt;br&gt;скрытые тесты по группам, тесты обучающегося&lt;br&gt;на эталоне и на мутантах&lt;/span&gt;&lt;br&gt;&lt;i&gt;&lt;span style=&quot;font-size:10px&quot;&gt;→ sandbox&lt;/span&gt;&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontFamily=Times New Roman;fontColor=#000000;fontSize=11;strokeWidth=1;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="60" y="740" width="400" height="130" as="geometry"/></mxCell><mxCell id="worker" value="&lt;b&gt;&lt;span style=&quot;font-size:12px&quot;&gt;worker&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Компонент: app/worker.py]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;Фоновый worker — задача asyncio того же процесса:&lt;br&gt;incidents, commands, idle, reaper, retention,&lt;br&gt;time_limit, quota&lt;/span&gt;&lt;br&gt;&lt;i&gt;&lt;span style=&quot;font-size:10px&quot;&gt;→ sessions, assessment_agent&lt;/span&gt;&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontFamily=Times New Roman;fontColor=#000000;fontSize=11;strokeWidth=1;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="490" y="740" width="400" height="130" as="geometry"/></mxCell><mxCell id="audit" value="&lt;b&gt;&lt;span style=&quot;font-size:12px&quot;&gt;audit&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Компонент: app/audit]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;Запись audit_logs и security_events;&lt;br&gt;agent_logs пишет llm_gateway&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontFamily=Times New Roman;fontColor=#000000;fontSize=11;strokeWidth=1;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="920" y="740" width="400" height="130" as="geometry"/></mxCell><mxCell id="health" value="&lt;b&gt;&lt;span style=&quot;font-size:12px&quot;&gt;health&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Компонент: main.py, app/health.py]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;Служебные эндпоинты:&lt;br&gt;GET /api/health, /metrics&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontFamily=Times New Roman;fontColor=#000000;fontSize=11;strokeWidth=1;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1350" y="740" width="400" height="130" as="geometry"/></mxCell><mxCell id="db" value="&lt;b&gt;&lt;span style=&quot;font-size:12px&quot;&gt;db&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Компонент: app/db.py]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;Доступ к данным: SQLAlchemy 2 async, asyncpg;&lt;br&gt;модели таблиц в пакетах модулей&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontFamily=Times New Roman;fontColor=#000000;fontSize=11;strokeWidth=1;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="60" y="900" width="400" height="120" as="geometry"/></mxCell><mxCell id="llm_gateway" value="&lt;b&gt;&lt;span style=&quot;font-size:12px&quot;&gt;llm_gateway&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Компонент: app/llm_gateway]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;GET /admin/llm/providers, /admin/llm/health, /llm/status;&lt;br&gt;PATCH /admin/llm/providers/{id}; POST /admin/llm/switch-mode;&lt;br&gt;fallback external → local → template&lt;/span&gt;&lt;br&gt;&lt;i&gt;&lt;span style=&quot;font-size:10px&quot;&gt;→ audit&lt;/span&gt;&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontFamily=Times New Roman;fontColor=#000000;fontSize=11;strokeWidth=1;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="490" y="900" width="400" height="120" as="geometry"/></mxCell><mxCell id="sandbox" value="&lt;b&gt;&lt;span style=&quot;font-size:12px&quot;&gt;sandbox&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Компонент: app/sandbox]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;Sandbox Manager (aiodocker): создание, exec, pause,&lt;br&gt;снимок, удаление; метки masso.session/user/kind/&lt;br&gt;instance; профили и лимиты&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontFamily=Times New Roman;fontColor=#000000;fontSize=11;strokeWidth=1;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="920" y="900" width="400" height="120" as="geometry"/></mxCell><mxCell id="x_7" value="Все модули работают с таблицами через «Доступ к данным» (db). Стрелкой «→» в блоке указаны модули, которые он вызывает через сервисные интерфейсы." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Times New Roman;fontColor=#000000;fontSize=11;align=left;verticalAlign=middle;fontStyle=2;spacing=2;" vertex="1" parent="1"><mxGeometry x="1350" y="900" width="400" height="110" as="geometry"/></mxCell><mxCell id="pg" value="&lt;b&gt;&lt;span style=&quot;font-size:12px&quot;&gt;PostgreSQL 18 + pgvector&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Контейнер]&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;strokeColor=#000000;fillColor=#FFFFFF;fontFamily=Times New Roman;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="1120" width="400" height="100" as="geometry"/></mxCell><mxCell id="llm" value="&lt;b&gt;&lt;span style=&quot;font-size:13px&quot;&gt;LLM-провайдеры&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Контейнеры и внешние системы]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;gpt2giga → GigaChat API, внешний OpenAI-совместимый&lt;br&gt;API, Ollama&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontFamily=Times New Roman;fontColor=#000000;fontSize=12;strokeWidth=1;align=center;verticalAlign=middle;spacing=4;dashed=1;dash