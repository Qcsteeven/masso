0;entryDy=0;" edge="1" parent="1" source="up" target="br"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="x_27" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#000000;fontFamily=Times New Roman;fontColor=#000000;fontSize=10;endSize=9;startSize=9;startArrow=none;endArrow=block;startFill=1;endFill=1;strokeWidth=1;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="br" target="cl"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="x_28" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#000000;fontFamily=Times New Roman;fontColor=#000000;fontSize=10;endSize=9;startSize=9;startArrow=none;endArrow=block;startFill=1;endFill=1;strokeWidth=1;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="cl" target="a1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="hint" value="&lt;b&gt;request_hint()&lt;/b&gt; &lt;span style=&quot;font-size:10px&quot;&gt;[сервисный метод вне графа, hints.py]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;не более 3 подсказок; фильтр prompt injection → security_events; тихий прогон проверок;&lt;br&gt;ответ LLM → LLM Gateway с фильтром элементов решения; без LLM — ступень лестницы&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontFamily=Times New Roman;fontColor=#000000;fontSize=12;strokeWidth=1;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="100" y="545" width="700" height="70" as="geometry"/></mxCell><mxCell id="self" value="&lt;b&gt;self_check()&lt;/b&gt; &lt;span style=&quot;font-size:10px&quot;&gt;[сервисный метод вне графа, selfcheck.py]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;проверки на текущем состоянии среды не чаще раза в 30 с; только названия критериев&lt;br&gt;и результат, без баллов; событие check с self_check в цифровом следе&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontFamily=Times New Roman;fontColor=#000000;fontSize=12;strokeWidth=1;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="850" y="545" width="710" height="70" as="geometry"/></mxCell><mxCell id="gw" value="&lt;b&gt;&lt;span style=&quot;font-size:13px&quot;&gt;LLM Gateway&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Компонент: app/llm_gateway]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;complete_json(): ответ по схеме Pydantic, один повтор;&lt;br&gt;embed(): эмбеддинги провайдера или hash-эмбеддинги;&lt;br&gt;каждый вызов — в agent_logs; ошибка провайдера —&lt;br&gt;отдельной транзакцией не чаще раза в 30 с&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontFamily=Times New Roman;fontColor=#000000;fontSize=12;strokeWidth=1;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="100" y="740" width="520" height="150" as="geometry"/></mxCell><mxCell id="x_29" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#000000;fontFamily=Times New Roman;fontColor=#000000;fontSize=10;endSize=9;startSize=9;startArrow=none;endArrow=block;startFill=1;endFill=1;strokeWidth=1;exitX=0.3714;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;dashed=1;dashPattern=4 3;" edge="1" parent="1" source="hint" target="gw"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="x_30" value="подсказки, эмбеддинги" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Times New Roman;fontColor=#000000;fontSize=10;align=center;verticalAlign=middle;fontStyle=0;spacing=2;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="255.0" y="681.5" width="210" height="17" as="geometry"/></mxCell><mxCell id="ext" value="&lt;b&gt;&lt;span style=&quot;font-size:13px&quot;&gt;external&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[провайдер, приоритет 1]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;gpt2giga → GigaChat API или иной&lt;br&gt;OpenAI-совместимый API [HTTPS]&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontFamily=Times New Roman;fontColor=#000000;fontSize=12;strokeWidth=1;align=center;verticalAlign=middle;spacing=4;dashed=1;dashPattern=4 3;" vertex="1" parent="1"><mxGeometry x="720" y="740" width="330" height="100" as="geometry"/></mxCell><mxCell id="loc" value="&lt;b&gt;&lt;span style=&quot;font-size:13px&quot;&gt;local&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[провайдер, приоритет 2]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Ollama или иной локальный&lt;br&gt;OpenAI-совместимый сервер [HTTP]&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontFamily=Times New Roman;fontColor=#000000;fontSize=12;strokeWidth=1;align=center;verticalAlign=middle;spacing=4;dashed=1;dashPattern=4 3;" vertex="1" parent="1"><mxGeometry x="1150" y="740" width="330" height="100" as="geometry"/></mxCell><mxCell id="tpl" value="&lt;b&gt;&lt;span style=&quot;font-size:13px&quot;&gt;template&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[приоритет 3, без LLM]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;утверждённые варианты легенд,&lt;br&gt;лестница подсказок&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontFamily=Times New Roman;fontColor=#000000;fontSize=12;strokeWidth=1;align=center;verticalAlign=middle;spacing=4;dashed=1;dashPattern=4 3;" vertex="1" parent="1"><mxGeometry x="1580" y="740" width="330" height="100" as="geometry"/></mxCell><mxCell i