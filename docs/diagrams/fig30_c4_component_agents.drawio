/mxGeometry></mxCell><mxCell id="x_36" value="ошибка или&lt;br&gt;недоступен" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Times New Roman;fontColor=#000000;fontSize=10;align=center;verticalAlign=middle;fontStyle=0;spacing=2;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1482.0" y="756.0" width="96" height="32" as="geometry"/></mxCell><mxCell id="x_37" value="Режим генерации задаёт администратор (llm_settings.generation_mode): external — цепочка external → local → template; local — local → template; template — только шаблонный путь. ScenarioAgent вызывает LLM Gateway из узлов generate_legend и dedup." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Times New Roman;fontColor=#000000;fontSize=10;align=left;verticalAlign=middle;fontStyle=2;spacing=2;" vertex="1" parent="1"><mxGeometry x="720" y="850" width="1200" height="44" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>