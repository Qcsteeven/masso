;" vertex="1" parent="1"><mxGeometry x="600" y="425" width="210" height="90" as="geometry"/></mxCell><mxCell id="up" value="&lt;b&gt;update_profile&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;уровни навыков&lt;br&gt;→ ProfileAgent.apply_result&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontFamily=Times New Roman;fontColor=#000000;fontSize=12;strokeWidth=1;align=center;verticalAlign=middle;spacing=4;arcSize=14;" vertex="1" parent="1"><mxGeometry x="850" y="425" width="210" height="90" as="geometry"/></mxCell><mxCell id="br" value="&lt;b&gt;build_report&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;verification_results&lt;br&gt;и reports → PostgreSQL&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontFamily=Times New Roman;fontColor=#000000;fontSize=12;strokeWidth=1;align=center;verticalAlign=middle;spacing=4;arcSize=14;" vertex="1" parent="1"><mxGeometry x="1100" y="425" width="210" height="90" as="geometry"/></mxCell><mxCell id="cl" value="&lt;b&gt;cleanup&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;удаление учебной среды&lt;br&gt;→ Sandbox Manager&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontFamily=Times New Roman;fontColor=#000000;fontSize=12;strokeWidth=1;align=center;verticalAlign=middle;spacing=4;arcSize=14;" vertex="1" parent="1"><mxGeometry x="1350" y="425" width="210" height="90" as="geometry"/></mxCell><mxCell id="a1" value="" style="ellipse;html=1;strokeColor=#000000;fillColor=#FFFFFF;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="1627" y="457" width="26" height="26" as="geometry"/></mxCell><mxCell id="x_21" value="" style="ellipse;html=1;strokeColor=#000000;fillColor=#000000;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="1632" y="462" width="16" height="16" as="geometry"/></mxCell><mxCell id="x_22" value="" style="ed